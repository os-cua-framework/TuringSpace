diff --git a/dynamic_captchas/server/challenge_manager.py b/dynamic_captchas/server/challenge_manager.py
index 473f0a9..ffc2336 100644
--- a/dynamic_captchas/server/challenge_manager.py
+++ b/dynamic_captchas/server/challenge_manager.py
@@ -86,6 +86,19 @@ class ChallengeManager:
 
         return result
 
+    def build_seeded_challenge(self, challenge_type: str, seed: int, requires_submit=None, dataset_scope: str = "dynamic") -> Tuple[str, int]:
+        """Build one reproducible challenge without changing the server RNG stream (scope "static" = held-out assets)."""
+        with self._static_rng_lock:
+            original_state = random.getstate()
+            try:
+                random.seed(seed)
+                html, status = self.build_challenge(challenge_type, requires_submit=requires_submit, dataset_scope=dataset_scope)
+                if status == 200 and isinstance(html, str):
+                    html = self._inject_static_client_rng(html, random.getrandbits(32))
+                return html, status
+            finally:
+                random.setstate(original_state)
+
     def _inject_static_client_rng(self, html: str, seed: int) -> str:
         """Inject a deterministic RNG helper for client-side positioning."""
 
